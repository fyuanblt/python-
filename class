class Dog:
    # 类属性（所有实例共享）
    species = "犬科"

    # 初始化方法（构造方法）
    def __init__(self, name, age):  初始化直接age=1
        # 实例属性（每个对象独有）
        self.name = name
        self.age = age

    # 实例方法
    def bark(self):
        print(f"{self.name} 在叫：汪汪！")

    # 实例方法，带参数
    def info(self):
        print(f"名字：{self.name}，年龄：{self.age}")


# 创建对象（实例化）
d1 = Dog("旺财", 3)
d2 = Dog("小白", 1)

# 调用方法
d1.bark()      # 旺财 在叫：汪汪！
d2.info()      # 名字：小白，年龄：1

# 访问属性
print(d1.name)        # 旺财
print(Dog.species)    # 犬科



class Animal:
    def __init__(self, name):
        self.name = name

    def speak(self):
        print(f"{self.name} 发出声音")


# 子类继承 Animal
class Cat(Animal):
    def speak(self):
        # 重写父类方法
        print(f"{self.name} 喵喵叫")


class Dog(Animal):
    def speak(self):
        print(f"{self.name} 汪汪叫")


a = Cat("咪咪")
b = Dog("旺财")

a.speak()   # 咪咪 喵喵叫
b.speak()   # 旺财 汪汪叫
